# Server Port
PORT=5001

# Firebase Project Configuration
FIREBASE_PROJECT_ID=church-5d638

# Optional: Path to service account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Secret for triggering daily reminder endpoint remotely via Cloud Scheduler
# curl -X POST http://localhost:5001/api/reminders/run-daily -H "Authorization: Bearer my-secure-cron-secret"
CRON_SECRET=csi_church_secure_cron_secret_2026

# Set to true to automatically start daily background cron runner in this process
RUN_CRON=true
