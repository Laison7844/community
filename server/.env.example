# Server Port
PORT=5001

# Firebase Project Configuration
FIREBASE_PROJECT_ID=church-5d638

# Optional: Path to service account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Secret for triggering daily reminder endpoint remotely via Cloud Scheduler.
# CRITICAL: In production, generate a cryptographically strong secret (e.g. `openssl rand -hex 32`)
# and set it in Google Secret Manager / Cloud Run environment variables.
# The server strictly rejects placeholder or default secrets.
CRON_SECRET=replace_with_strong_random_secret_min_32_chars

# Set to true to automatically start daily background cron runner in this process
RUN_CRON=true

# Server timezone (defaults to Asia/Kolkata for church events)
TIMEZONE=Asia/Kolkata
